# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 days

# ── AI Provider ───────────────────────────────────────────────────────────────
# Set the provider and the matching key. Supported: openai, anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...your-openai-key-here...
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key-here...

# Model to use for Q&A answers
AI_MODEL=gpt-4o-mini

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory where skill files are stored per user
# Default: ~/.bookskill/skills  (set to /var/app/skills in production)
SKILLS_ROOT=~/.bookskill/skills

# Max upload size in bytes (default 50 MB)
MAX_UPLOAD_BYTES=52428800

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./bookskill.db

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ── Usage Limits ─────────────────────────────────────────────────────────────
# Override per-tier limits here if needed; defaults are coded in models.py
# TIER_FREE_BOOKS=2
# TIER_FREE_QUESTIONS=50
